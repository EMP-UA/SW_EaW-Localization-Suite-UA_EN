<Window x:Class="EaWLocalizationTool.GUI.ReviewMarkPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UA: Власний текст вичитки / EN: Custom review text"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgSurface}"
        Foreground="{DynamicResource TextPrim}"
        FontFamily="Segoe UI"
        FocusManager.FocusedElement="{Binding ElementName=ReviewTextBox}">

    <!--
        UA: Модальне вікно з одним рядком вводу — для масового проставлення
            ДОВІЛЬНОГО тексту вичитки кільком виділеним рядкам. Готові позначки
            «+», «+/-», «-» обираються прямо в контекстному меню таблиці.
        EN: Modal single-line prompt — for bulk-setting a FREE-FORM review text
            on several selected rows. The ready-made marks "+", "-", "+/-"
            are picked directly in the grid's context menu.
    -->
    <Border Background="{DynamicResource BgCard}" Padding="16" Margin="10"
            BorderBrush="{DynamicResource BdNorm}" BorderThickness="1" CornerRadius="6">
        <StackPanel>
            <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrim}"
                       Text="UA: Текст вичитки для всіх виділених рядків&#10;EN: Review text for all selected rows"/>
            <TextBlock x:Name="SelectionInfoText" FontSize="{DynamicResource FontUI}"
                       TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextSec}"/>
            <TextBlock FontSize="{DynamicResource FontUI}" TextWrapping="Wrap" Margin="0,4,0,12"
                       Foreground="{DynamicResource TextDim}"
                       Text="UA: Будь-який коментар, не лише готові позначки. Вичитаними вважають лише «+» і «+/-». Порожній текст ставить «-» (не вичитано).&#10;EN: Any comment, not only the ready-made marks. Only &quot;+&quot; and &quot;+/-&quot; count as reviewed. Empty text sets &quot;-&quot; (not reviewed)."/>

            <TextBox x:Name="ReviewTextBox" Style="{StaticResource DarkInput}"
                     Tag="UA: Текст вичитки / EN: Review text"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource DarkBtn}" Margin="0,0,8,0"
                        Content="UA: Скасувати / EN: Cancel"
                        IsCancel="True" Click="CancelButton_Click"/>
                <Button Style="{StaticResource PrimaryBtn}"
                        Content="✓ UA: Застосувати / EN: Apply"
                        IsDefault="True" Click="ApplyButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
