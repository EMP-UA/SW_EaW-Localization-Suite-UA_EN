<Window x:Class="EaWLocalizationTool.GUI.TransferReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UA: Звіт збігів / EN: Match report"
        Height="720" Width="1280" MinHeight="400" MinWidth="800"
        Background="{DynamicResource BgSurface}"
        Foreground="{DynamicResource TextPrim}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ ФІЛЬТРИ ТА ПОШУК / FILTERS AND SEARCH ═══════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BdAcc}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel>
                <WrapPanel x:Name="FilterPanel" Margin="0,0,0,6"/>
                <TextBlock x:Name="NoteText" Margin="0,0,0,6" TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSm}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrim}"/>
                <TextBlock x:Name="HintText" Margin="0,0,0,6" TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSm}"
                           Foreground="{DynamicResource TextSec}"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                               FontSize="{DynamicResource FontUI}"
                               Foreground="{DynamicResource TextSec}"
                               Text="UA: Пошук / EN: Search:"/>
                    <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Center"
                               Margin="12,0,0,0" FontSize="{DynamicResource FontUI}"
                               Foreground="{DynamicResource TextSec}"/>
                    <TextBox x:Name="SearchBox" Style="{StaticResource DarkInput}"
                             TextChanged="SearchBox_TextChanged"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ══ ТАБЛИЦЯ / GRID ══════════════════════════════════════════════════ -->
        <DataGrid Grid.Row="1" x:Name="ReportGrid"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionUnit="Cell" SelectionMode="Extended" ClipboardCopyMode="ExcludeHeader"
                  RowHeaderWidth="0" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource GridLine}"
                  BorderThickness="0"
                  Background="{DynamicResource RowBg}"
                  RowBackground="{DynamicResource RowBg}"
                  AlternatingRowBackground="{DynamicResource RowBgAlt}"
                  Foreground="{DynamicResource TextPrim}"
                  FontSize="{DynamicResource FontSm}"
                  EnableRowVirtualization="True">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="ContentTemplateSelector" Value="{StaticResource BilingualSelector}"/>
                    <Setter Property="Background"      Value="{DynamicResource HdrBg}"/>
                    <Setter Property="Foreground"      Value="{DynamicResource TextSec}"/>
                    <Setter Property="FontWeight"      Value="SemiBold"/>
                    <Setter Property="Padding"         Value="10,8"/>
                    <Setter Property="BorderBrush"     Value="{DynamicResource BdAcc}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="UA: Копіювати комірки / EN: Copy cells" InputGestureText="Ctrl+C"
                              Click="CopyCells_Click"/>
                    <MenuItem Header="UA: Копіювати рядки / EN: Copy rows"
                              Click="CopyRows_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Resources>
                <Style x:Key="WrapCell" TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="Padding"      Value="8,5"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="190"
                                    ElementStyle="{StaticResource WrapCell}"/>
                <DataGridTextColumn Header="UA: Вид збігу / EN: Match type" Binding="{Binding KindLabel}" Width="230"
                                    ElementStyle="{StaticResource WrapCell}"/>
                <DataGridTextColumn Header="UA: Переклади різняться / EN: Translations differ" Binding="{Binding DifferLabel}" Width="120"
                                    ElementStyle="{StaticResource WrapCell}"/>
                <DataGridTextColumn Header="UA: Англійська, основна гра (за ключем) / EN: English, base game (by key)"
                                    Binding="{Binding DonorOriginal}" Width="2*"
                                    ElementStyle="{StaticResource WrapCell}"/>
                <DataGridTextColumn Header="UA: Англійська, доповнення / EN: English, expansion"
                                    Binding="{Binding TargetOriginal}" Width="2*"
                                    ElementStyle="{StaticResource WrapCell}"/>
                <DataGridTextColumn Header="UA: Переклад, основна гра (за ключем) / EN: Translation, base game (by key)"
                                    Binding="{Binding ByKey}" Width="2*"
                                    ElementStyle="{StaticResource WrapCell}"/>
                <DataGridTextColumn Header="UA: Переклад, основна гра (за англійською фразою) / EN: Translation, base game (by English phrase)"
                                    Binding="{Binding ByText}" Width="2*"
                                    ElementStyle="{StaticResource WrapCell}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ══ КНОПКИ / BUTTONS ════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BdAcc}" BorderThickness="0,1,0,0"
                Padding="12,8">
            <DockPanel>
                <TextBlock x:Name="PathText" DockPanel.Dock="Left" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="640"
                           FontSize="{DynamicResource FontSm}"
                           Foreground="{DynamicResource TextSec}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource DarkBtn}" Margin="0,0,8,0"
                            Content="📂 UA: Відкрити теку / EN: Open folder"
                            Click="OpenFolderButton_Click"/>
                    <Button Style="{StaticResource PrimaryBtn}"
                            Content="UA: Закрити / EN: Close" IsCancel="True"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
